ed=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#7a7a7a;strokeWidth=1;fontSize=10;fontColor=#555555;" edge="1" parent="1" source="g3" target="g22"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p211677921" name="2. Classes — Socle métier"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Classes du module « Socle métier »" style="text;html=1;align=left;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="n2" value="8 classes, dont 0 sous-documents embarqués.&lt;br&gt;« &lt;&gt; » en tête de nom marque un sous-document : pas de collection propre.&lt;br&gt;Losange plein = composition (tableau de sous-documents). Flèche = référence ObjectId.&lt;br&gt;Les boîtes grisées en pointillés sont des classes d&#x27;AUTRES modules, rappelées ici pour qu&#x27;aucune référence ne paraisse pendante.&lt;br&gt;Deux classes peuvent partager un code (ex. « processus ») sans qu&#x27;il y ait de référence : ce n&#x27;est pas une relation, rien n&#x27;est donc tracé." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="700" height="130" as="geometry"/></mxCell><mxCell id="k3" value="AssembleeGenerale  [assembleesGenerales]" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="290" height="158" as="geometry"/></mxCell><mxCell id="k3_f0" value="+ mandat : ObjectId→Mandat" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign