ent partager un code (ex. « processus ») sans qu&#x27;il y ait de référence : ce n&#x27;est pas une relation, rien n&#x27;est donc tracé." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="700" height="130" as="geometry"/></mxCell><mxCell id="k3" value="ElementCorbeille  [corbeille]" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="290" height="246" as="geometry"/></mxCell><mxCell id="k3_f0" value="+ module : string" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;html=1;" vertex="1" parent="k3"><mxGeometry y="26" width="290" height="22" as="geometry"/></mxCell><mxCell id="k3_f1" value="+ type : string" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;html=1;" vertex="1" parent="k3"><mxGeometry y="48" width="290" height="22" as="geometry"/></mxCell><mxCell id="k3_f2" value="+ titre : string" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;html=1;" vertex="1" parent="k3"><mxGeometry y="70" width="290" height="22" as="geometry"/></mxCell><mxCell id="k3_f3" value="- description : string" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;html=1;" vertex="1" parent="k3"><mxGeometry y="92" width="290" height="22" as="geometry"/></mxCell><mxCell id="k3_f4" value="+ donnees : any" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;html=1;" vertex="1" parent="k3"><mxGeometry y="114" width="290" height="22" as="geometry"/></mxCell><mxCell id="k3_f5" value="- fichiers : Obj