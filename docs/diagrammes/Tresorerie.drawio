<mxfile host="app.diagrams.net" agent="Tresorerie" type="device"><diagram id="p691286249" name="1. Classes — vue d&#x27;ensemble"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Trésorerie — cartographie des classes et des dépendances" style="text;html=1;align=left;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="n2" value="Une boîte = un modèle Mongoose, donc une collection. Les sous-documents embarqués sont au diagramme de leur module.&lt;br&gt;Les flèches relient les MODULES, pas les classes : une flèche « A → B, n réf. » signifie que n champs du module A pointent vers des classes de B.&lt;br&gt;Le détail classe par classe est sur la page du module : tracer ici les 50 références rendrait la page illisible.&lt;br&gt;35 classes racines réparties sur 4 modules." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="700" height="120" as="geometry"/></mxCell><mxCell id="g3" value="Socle métier" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=50;arcSize=0;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="750" height="238" as="geometry"/></mxCell><mxCell id="k4" value="AssembleeGenerale" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="270" width="220" height="36" as="geometry"/></mxCell><mxCell id="k5" value="Client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="270" width="220" h