# ==============================================================
# Trésorerie — variables d'environnement
#
# Copiez ce fichier vers .env.local et remplissez les valeurs.
# .env.local n'est JAMAIS commité (voir .gitignore) : il porte vos
# identifiants de base et le secret de session.
# ==============================================================


# --- 1. OÙ SONT STOCKÉES LES DONNÉES --------------------------
#
# Une seule ligne à renseigner : MONGODB_URI. Trois façons de
# l'obtenir, au choix — en local sur ce PC, ou en ligne.
#
#   A. LOCAL, SANS RIEN INSTALLER  (le plus simple)
#      npm run base:locale    (laissez la fenêtre ouverte)
#      Télécharge une fois un vrai MongoDB et le démarre ; les
#      données restent dans .donnees/mongo, sur ce poste.
#      MONGODB_URI="mongodb://127.0.0.1:27018/tresorerie"
#
#   B. LOCAL, AVEC DOCKER
#      docker compose up -d
#      MONGODB_URI="mongodb://127.0.0.1:27017/tresorerie"
#
#   C. EN LIGNE (plusieurs postes, sauvegardes gérées)
#      MongoDB Atlas, offre gratuite M0 : Cluster → Connect →
#      Drivers → copier la chaîne de connexion.
#      MONGODB_URI="mongodb+srv://<user>:<mot-de-passe>@<cluster>.mongodb.net/tresorerie?retryWrites=true&w=majority"
#
# Local ou en ligne, l'application est la même : seule cette ligne
# change. Passer de l'un à l'autre ne migre PAS les données — il
# faut les exporter (mongodump) et les réimporter.
#
MONGODB_URI="mongodb://127.0.0.1:27018/tresorerie"


# --- 2. SESSIONS ----------------------------------------------
#
# Secret qui signe les cookies de session. Obligatoire.
# Générer avec :  npx auth secret     (ou : openssl rand -base64 32)
# Le changer déconnecte tout le monde — sans autre conséquence.
AUTH_SECRET=""


# --- 3. PREMIER COMPTE (npm run seed) -------------------------
#
# Crée l'exercice en cours et le premier compte administrateur.
# Ce mot de passe est PROVISOIRE : changez-le à la première
# connexion, depuis Administration › Comptes.
SEED_ADMIN_EMAIL="tresorier@exemple.org"
SEED_ADMIN_NOM="Prénom Nom"
SEED_ADMIN_PASSWORD=""


# --- 4. E-MAILS (optionnel) -----------------------------------
#
# Sans clé, les e-mails ne sont pas envoyés : ils sont écrits dans
# la console du serveur. L'application reste pleinement utilisable
# — les relances se font alors à la main.
# resend.com → API Keys (offre gratuite)
RESEND_API_KEY=""
EMAIL_FROM="Trésorerie <tresorerie@exemple.org>"


# --- 5. BASE LOCALE : réglages (optionnel) --------------------
#
# Utilisés seulement par `npm run base:locale`.
# PORT_MONGO=27018
# NOM_BASE=tresorerie
# DONNEES_LOCALES=.donnees/mongo
