{
  "name": "tresorerie-associations",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/avec-memoire.mjs next dev",
    "build": "node scripts/avec-memoire.mjs next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node scripts/avec-memoire.mjs tsc --noEmit",
    "verif": "npm run typecheck && npm run lint && npm test",
    "verif:cibles": "node scripts/verif-types.mjs",
    "test": "vitest run",
    "base:locale": "node --import tsx scripts/base-locale.ts",
    "etat": "node --env-file=.env.local --import tsx scripts/etat-base.ts",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "compte:test": "node --env-file=.env.local --import tsx scripts/compte-test.ts",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:contrats": "vitest run tests/contrats",
    "test:securite": "vitest run tests/securite"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.13.0",
    "mongoose": "^9.7.4",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "mongodb-memory-server": "^11.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
